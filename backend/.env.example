# .env.example — 실제 값은 넣지 말고 복사해서 .env로 사용 (.env는 .gitignore에 포함)
# 운영(prod 프로파일, 외부 관리형 DB/SSL Redis) 기준 예시. 로컬 데모는 루트의 .env.example을 사용

# 서버/런타임
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul
COOKIE_SECURE=true
FRONTEND_URL=https://your-frontend-domain
CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# 데이터베이스 (MariaDB/MySQL)
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:mariadb://your-db-host:3306/your_db_name?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=true&trustServerCertificate=true
SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=0
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Redis (토큰, 예약, 분산 락, 스트림)
REDIS_HOST=your-redis-host
REDIS_PORT=10000
REDIS_PASSWORD=change-me
SPRING_DATA_REDIS_PORT=10000
SPRING_DATA_REDIS_SSL_ENABLED=true

# 인증 (JWT, OAuth)
JWT_SECRET=change-me-to-a-long-random-string
FT_CLIENT_ID=your-42-client-id
FT_CLIENT_SECRET=change-me
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=change-me
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=change-me

# 이미지 저장소 (Azure Blob)
AZURE_STORAGE_CONNECTION_STRING=change-me
SPRING_CLOUD_AZURE_STORAGE_BLOB_CONNECTION_STRING=change-me

# AI 서버 (docker-compose 내부)
AI_SERVER_URL=http://ai:8000
AI_MODEL_PATH=models/efficientnetv2s_3class_traced_v2.0.0.pt

# 알림
SLACK_BOT_TOKEN=change-me
